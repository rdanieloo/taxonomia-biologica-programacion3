# Copiar a .env y ajustar valores:  cp .env.example .env

# ==========================================
# APLICACIÓN
# ==========================================
# Motor: custom | collections
APP_TREE_STRATEGY=custom
# Persistencia: memory | postgres | neo4j | mongo
APP_STORAGE=memory
# Perfil Spring (vacío = memoria; postgres | neo4j | mongo según storage)
SPRING_PROFILES_ACTIVE=
SPRING_APPLICATION_NAME=taxonomia-api
APP_PORT=8080
JAVA_OPTS=-Xms256m -Xmx512m
LOGGING_LEVEL_ROOT=INFO

# ==========================================
# POSTGRESQL (perfil db)
# ==========================================
POSTGRES_DB=taxonomia_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_VERSION=16
# Solo si APP_STORAGE=postgres:
# SPRING_PROFILES_ACTIVE=postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/taxonomia_db

# ==========================================
# NEO4J (perfil db)
# ==========================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_VERSION=5
# Solo si APP_STORAGE=neo4j:
# SPRING_PROFILES_ACTIVE=neo4j
# SPRING_NEO4J_URI=bolt://neo4j:7687

# ==========================================
# MONGODB (perfil db)
# ==========================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password
MONGO_INITDB_DATABASE=taxonomia_db
MONGO_PORT=27017
MONGO_VERSION=7
# Solo si APP_STORAGE=mongo:
# SPRING_PROFILES_ACTIVE=mongo
# SPRING_DATA_MONGODB_URI=mongodb://admin:password@mongodb:27017/taxonomia_db?authSource=admin
